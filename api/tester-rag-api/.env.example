OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Code agent
CODE_AGENT_DATA_DIR=./data
CODE_AGENT_CHECKPOINT_DB=./data/code_agent_runs.db
CODE_AGENT_WORKTREES_DIR=./data/worktrees
CODE_AGENT_MAX_VERIFIER_ITERATIONS=3
# When true (default), `dart analyze` errors on changed lib files block the
# verifier and trigger a dev retry. Set false to downgrade them to advisory.
CODE_AGENT_ANALYZE_BLOCKING=true
CODE_AGENT_CORS_ORIGINS=*

# Dart / Flutter tooling (optional overrides)
DART_BIN=dart
FLUTTER_BIN=flutter
