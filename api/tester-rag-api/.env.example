OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Code agent
CODE_AGENT_DATA_DIR=./data
CODE_AGENT_CHECKPOINT_DB=./data/code_agent_runs.db
CODE_AGENT_WORKTREES_DIR=./data/worktrees
CODE_AGENT_MAX_VERIFIER_ITERATIONS=3
# When true (default), `dart analyze` errors on changed lib files block the
# verifier and trigger a dev retry. Set false to downgrade them to advisory.
CODE_AGENT_ANALYZE_BLOCKING=true
CODE_AGENT_CORS_ORIGINS=*

# Dart / Flutter tooling (optional overrides)
DART_BIN=dart
FLUTTER_BIN=flutter

# Dev loop runtime: "legacy" (default, unchanged) or "sdk" (Claude Agent SDK —
# requires `pip install -e ".[sdk]"`). Leave unset/legacy to change nothing.
CODE_AGENT_DEV_RUNTIME=legacy
# Only needed if you're NOT already logged into Claude Code locally (`claude
# login`) — the SDK falls back to that login state automatically when this is
# unset. Only used by the sdk runtime above.
ANTHROPIC_API_KEY=
# Optional overrides for the sdk runtime — sane defaults if left unset.
# CODE_AGENT_DEV_SDK_MODEL=claude-opus-5
# CODE_AGENT_DEV_SDK_EFFORT=xhigh
# CODE_AGENT_DEV_SDK_MAX_TURNS=40
# CODE_AGENT_DEV_SDK_MAX_BUDGET_USD=0

# Planner runtime: "legacy" (default, unchanged) or "sdk" (Claude Agent SDK —
# same ANTHROPIC_API_KEY / Claude Code login fallback as the dev runtime above,
# independent flag). Leave unset/legacy to change nothing.
CODE_AGENT_PLANNER_RUNTIME=legacy
# Optional overrides for the planner sdk runtime — sane defaults if left unset.
# CODE_AGENT_PLANNER_SDK_MODEL=claude-opus-5
# CODE_AGENT_PLANNER_SDK_EFFORT=high
# Turn cap for Claude Code's own exploration loop. 0 (default) = unbounded:
# it explores until the plan is done. Only set a number to hard-stop a run
# you suspect is stuck — a cap that trips produces NO plan at all.
# CODE_AGENT_PLANNER_SDK_MAX_TURNS=0
# Cost ceiling in USD; 0 (default) = off. Meaningful on API-key auth only.
# CODE_AGENT_PLANNER_SDK_MAX_BUDGET_USD=0
# Retries for transient failures only (dropped stream, overload, rate limit).
# Auth errors and turn-limit hits never retry. 0 disables. Default 2.
# CODE_AGENT_PLANNER_SDK_MAX_RETRIES=2
